{
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "editor.tabSize": 2,
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "git.autofetch": true,
  "gitlens.hovers.currentLine.over": "line",
  "gitlens.codeLens.enabled": false,
  "explorer.confirmDragAndDrop": false,
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.bracketPairColorization.enabled": false,
  "editor.minimap.enabled": false,
  "editor.inlineSuggest.enabled": true,
  "github.copilot.enable": {
    "*": true,
    "yaml": false,
    "plaintext": true,
    "markdown": false,
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js, ${capture}.typegen.ts",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts, ${capture}.typegen.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml",
    "*.mts": "${capture}.typegen.ts",
    "*.cts": "${capture}.typegen.ts",
  },
  "github.copilot.advanced": {},
  "remoteHub.commitDirectlyWarning": "off",
  "git.mergeEditor": false,
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "eslint.format.enable": true,
  "workbench.colorCustomizations": {
    "[Henna]": {
      "activityBar.background": "#181a1f",
      "activityBar.foreground": "#bfbfbf",
      "editor.background": "#1d1f25",
    },
  },
  "[python]": {
    "editor.formatOnType": true,
    "editor.defaultFormatter": "ms-python.python",
  },
  "diffEditor.renderSideBySide": false,
  "svelte.enable-ts-plugin": true,
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode",
  },
  "git.confirmSync": false,
  "typescript.tsserver.log": "off",
  "git.suggestSmartCommit": false,
  "editor.unicodeHighlight.allowedCharacters": {
    "‎": true,
  },
  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
  },
  "workbench.colorTheme": "Brackets Light Pro Bold",
  "explorer.confirmDelete": false,
  "diffEditor.maxComputationTime": 0,
  "explorer.confirmPasteNative": false,
  "cursor.cpp.disabledLanguages": ["yaml", "markdown"],
  "security.promptForLocalFileProtocolHandling": false,
  "claudeCode.preferredLocation": "panel",
  "git.ignoreRebaseWarning": true,
  "eslint.validate": [
    "astro",
    "typescript", // Enable .ts
    "typescriptreact", // Enable .tsx
  ],
}